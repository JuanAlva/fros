<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Longitudes -->
    <xacro:property name="L1" value="0.2"/>
    <xacro:property name="L2" value="0.2"/>

    <!-- Espesores -->
    <xacro:property name="link_width" value="0.02"/>
    <xacro:property name="link_height" value="0.02"/>
    
    <!-- base -->
    <xacro:property name="base_length" value="0.1"/>
    <xacro:property name="base_radius" value="0.05"/>

    <!-- link3 -->
    <xacro:property name="link3_length" value="0.1"/>
    <xacro:property name="link3_width" value="0.02"/>
    <xacro:property name="link3_height" value="0.02"/>

    <!-- link4 -->
    <xacro:property name="link4_length" value="0.4"/>
    <xacro:property name="link4_width" value="0.02"/>
    <xacro:property name="link4_height" value="0.02"/>
    

    <xacro:property name="L3" value="0.1"/>
    <xacro:property name="link3_width" value="0.02"/>
    <xacro:property name="prismatic_lower" value="-0.05"/>
    <xacro:property name="prismatic_upper" value="0.05"/>
    <xacro:property name="link4_width" value="0.04"/>
</robot>