<?xml version="1.0"?>

<robot name="double_pendulum" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="double_pendulum_params.xacro"/>

  <!-- World link -->
  <link name="world"/>

  <!-- Link base (fijo) -->
  <link name="base_link">
      <visual>
          <origin xyz="0 0 ${base_length/2}"/>
          <geometry>
              <cylinder radius="${base_radius}" length="${base_length}"/>
          </geometry>
          <material name="green">
              <color rgba="0 1 0 1"/>
          </material>
      </visual>
      <collision>
          <origin xyz="0 0 ${base_length/2}"/>
          <geometry>
              <cylinder radius="${base_radius}" length="${base_length}"/>
          </geometry>
      </collision>
  </link>

  <!-- Primer eslabón -->
  <link name="link1">
      <visual>
          <origin xyz="${L1/2} 0 0"/>
          <geometry>
              <box size="${L1+0.02} ${link_width} ${link_height}"/>
          </geometry>
          <material name="blue">
              <color rgba="0 0 1 1"/>
          </material>
      </visual>
      <collision>
          <origin xyz="${L1/2} 0 0"/>
          <geometry>
              <box size="${L1+0.02} ${link_width} ${link_height}"/>
          </geometry>
      </collision>
  </link>

  <!-- Segundo eslabón -->
  <link name="link2">
      <visual>
          <origin xyz="0.1 0 0"/>
          <geometry>
              <box size="0.22 0.02 0.02"/>
          </geometry>
          <material name="red">
              <color rgba="1 0 0 1"/>
          </material>
      </visual>
      <collision>
          <origin xyz="0.1 0 0"/>
          <geometry>
              <box size="0.2 0.02 0.02"/>
          </geometry>
      </collision>
  </link>

  <!-- Tercer eslabón -->
  <link name="link3">
    <visual>
        <origin xyz="0 0 ${L3/2}"/>
        <geometry>
            <box size="${link3_width} ${link3_width} ${L3}"/>
        </geometry>
        <material name="yellow"><color rgba="1 1 0 1"/></material>
    </visual>
    <collision>
        <origin xyz="0 0 ${L3/2}"/>
        <geometry>
            <box size="${link3_width} ${link3_width} ${L3}"/>
        </geometry>
    </collision>
  </link>

  <link name="link4">
    <visual>
        <origin xyz="0 0 ${link4_width/2}"/>
        <geometry>
            <box size="${link4_width} ${link4_width} ${link4_width}"/>
        </geometry>
        <material name="purple"><color rgba="0.6 0 0.6 1"/></material>
    </visual>
    <collision>
        <origin xyz="0 0 ${link4_width/2}"/>
        <geometry>
            <box size="${link4_width} ${link4_width} ${link4_width}"/>
        </geometry>
    </collision>
  </link>

  <!--******************* DEFINICIONES DE JUNTAS  *******************-->
  <!-- Junta fija entre world y base_link -->
  <joint name="fixed" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Junta entre base y link1 -->
  <joint name="joint1" type="revolute">
      <parent link="base_link"/>
      <child link="link1"/>
      <origin xyz="0 0 ${base_length/2}"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000" lower="-3.14" upper="3.14" velocity="5"/>
  </joint>

  <!-- Junta entre link1 y link2 -->
  <joint name="joint2" type="revolute">
      <parent link="link1"/>
      <child link="link2"/>
      <origin xyz="${L1} 0 ${link_height}"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000" lower="-3.14" upper="3.14" velocity="5"/>
  </joint>

  <!-- Junta entre link2 y link3 -->
  <joint name="joint3" type="revolute">
      <parent link="link2"/>
      <child link="link3"/>
      <origin xyz="0.2 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000" lower="-3.14" upper="3.14" velocity="5"/>
  </joint>

  <!-- Junta entre link3 y link4 -->
  <joint name="joint4" type="revolute">
      <parent link="link3"/>
      <child link="link4"/>
      <origin xyz="0 0 ${L3}"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000" lower="-3.14" upper="3.14" velocity="5"/>
  </joint>
</robot>

