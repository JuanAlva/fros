<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Longitudes de los eslabones -->
    <xacro:property name="L1" value="0.2"/>
    <xacro:property name="L2" value="0.2"/>
    <xacro:property name="L4" value="0.1"/>

    <!-- Espesores comunes a los eslabones tipo "barra" -->
    <xacro:property name="link_width" value="0.02"/>
    <xacro:property name="link_height" value="0.02"/>

    <!-- Poste cilíndrico de la junta prismática (algo más largo que L2) -->
    <xacro:property name="L3" value="0.3"/>
    <xacro:property name="link3_radius" value="0.008"/>

    <!-- Largo de la base (cilindro verde), igual al de la roja -->
    <xacro:property name="base_length" value="0.2"/>
    <xacro:property name="base_radius" value="0.05"/>

    <!-- Bloque casi cúbico de la junta rotacional adicional, alargado para ver la rotación -->
    <xacro:property name="link4_length" value="0.09"/>
    <xacro:property name="link4_width" value="0.06"/>

    <!-- Límites de la junta prismática (sube y baja en Z desde el punto de montaje) -->
    <xacro:property name="prismatic_lower" value="-0.075"/>
    <xacro:property name="prismatic_upper" value="0.075"/>
    <xacro:property name="prismatic_effort" value="500"/>
    <xacro:property name="prismatic_velocity" value="0.2"/>

    <!-- Límites comunes a las juntas rotacionales -->
    <xacro:property name="revolute_lower" value="-3.14"/>
    <xacro:property name="revolute_upper" value="3.14"/>
    <xacro:property name="revolute_effort" value="1000"/>
    <xacro:property name="revolute_velocity" value="5"/>

</robot>
